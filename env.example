# For running on your own computer only. Copy to .env is NOT automatic: export these in your shell,
# or just run `npm start` -- everything has safe local defaults (fake payment page, no emails).
# On Render you enter the same names in the dashboard instead. NEVER commit real keys.
PORT=3000
BASE_URL=http://localhost:3000
SETUP_KEY=local-dev-setup-key-change-me
# REQUIRE_PAYMENT=false      # launch without the $5 fee (no Stripe needed)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# MAIL_API_KEY=
# MAIL_FROM=Barberchops <bookings@your-domain.com>
